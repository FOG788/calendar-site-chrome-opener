{
  "manifest_version": 3,
  "name": "Calendar Site Opener",
  "version": "0.1.0",
  "description": "Open URLs from Google Calendar events in new Chrome tabs.",
  "permissions": [
    "alarms",
    "commands",
    "identity",
    "storage",
    "tabs",
    "windows",
    "scripting"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "<all_urls>"
  ],
  "oauth2": {
    "client_id": "398440037614-qs875pae8kfk9a85vtfl5vkpuihkl9g6.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar",
      "https://www.googleapis.com/auth/calendar.events"
    ]
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Calendar Site Opener"
  },
  "options_page": "options.html",
  "commands": {
    "open-create-event-form": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "予定追加フォームを開く"
    }
  }
}
